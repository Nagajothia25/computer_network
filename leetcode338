class Solution {
public:
    vector<int> countBits(int n) {
        vector<int> ans(n + 1, 0);
        
        for (int i = 0; i <= n; i++) {
            int num = i;
            int count = 0;
            
            // Count bits for the current number
            while (num > 0) {
                count += (num & 1); // Add 1 if the last bit is 1
                num >>= 1;          // Shift right to check the next bit
            }
            
            ans[i] = count;
        }
        
        return ans;
    }
};
