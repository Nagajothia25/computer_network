class Solution {
public:
    int findComplement(int num) {
        int ans = 0;
        long long placeValue = 1; // Tracks the current bit position (1, 2, 4, 8...)

        while (num > 0) {
            // 1. Get the current last bit
            int currentBit = num & 1; 
            
            // 2. Flip the bit (if 1 becomes 0, if 0 becomes 1)
            int flippedBit = currentBit ^ 1; 
            
            // 3. Add the flipped bit at its correct position
            ans += flippedBit * placeValue; 
            
            // 4. Move to the next bit
            placeValue *= 2; // Shift position left
            num >>= 1;       // Shift num right to drop the processed bit
        }
        
        return ans;
    }
};
